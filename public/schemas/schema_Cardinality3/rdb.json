{
  "version": "1.0",
  "description": "tablesディレクトリ内のCSVで表される各テーブルのRDBスキーマ情報。顧客と商品之多対多のカーディナリティーを中間テーブルで分割して表す。3テーブルで構成される。",
  "tables": [
    {
      "name": "顧客",
      "description": "顧客情報の一覧。各顧客は0件以上の商品を購入することができる。購入記録を通じて商品と多対多の関係。",
      "primaryKey": ["顧客ID"],
      "columns": [
        {
          "name": "顧客ID",
          "type": "INTEGER",
          "nullable": false,
          "autoIncrement": true,
          "comment": "主キー。顧客ID。"
        },
        {
          "name": "氏名",
          "type": "TEXT",
          "nullable": false,
          "comment": "顧客の氏名。"
        },
        {
          "name": "メールアドレス",
          "type": "TEXT",
          "nullable": false,
          "unique": true,
          "comment": "顧客のメールアドレス。"
        },
        {
          "name": "住所",
          "type": "TEXT",
          "nullable": true,
          "comment": "顧客の住所。"
        }
      ],
      "foreignKeys": [],
      "indexes": []
    },
    {
      "name": "商品",
      "description": "商品信息の一覧。1商品は複数のカテゴリに分類でき、複数の顧客に購入される。購入記録で顧客と多対多の関係。",
      "primaryKey": ["商品ID"],
      "columns": [
        {
          "name": "商品ID",
          "type": "INTEGER",
          "nullable": false,
          "autoIncrement": true,
          "comment": "主キー。商品ID。"
        },
        {
          "name": "商品名",
          "type": "TEXT",
          "nullable": false,
          "comment": "商品名。"
        },
        {
          "name": "価格",
          "type": "INTEGER",
          "nullable": false,
          "comment": "価格（円）。"
        },
        {
          "name": "メーカー",
          "type": "TEXT",
          "nullable": true,
          "comment": "メーカー名。"
        }
      ],
      "foreignKeys": [],
      "indexes": []
    },
    {
      "name": "購入記録",
      "description": "顧客と商品之多対多の関係を表す中間テーブル。1件の購入記録は1件の顧客と1件の商品に紐づく。1顧客は複数の商品を購入でき、1商品を複数の顧客に販売できる。主キーは顧客IDと商品IDの複合キー。",
      "primaryKey": ["顧客ID", "商品ID"],
      "columns": [
        {
          "name": "顧客ID",
          "type": "INTEGER",
          "nullable": false,
          "comment": "複合主キーであり外部キー。顧客.顧客ID を参照。多対多の関係。"
        },
        {
          "name": "商品ID",
          "type": "INTEGER",
          "nullable": false,
          "comment": "複合主キーであり外部キー。商品.商品ID を参照。多対多の関係。"
        },
        {
          "name": "数量",
          "type": "INTEGER",
          "nullable": false,
          "comment": "購入数量。"
        },
        {
          "name": "購入日",
          "type": "DATE",
          "nullable": false,
          "comment": "購入日。"
        }
      ],
      "foreignKeys": [
        {
          "name": "fk_purchase_customer",
          "columns": ["顧客ID"],
          "referencesTable": "顧客",
          "referencesColumns": ["顧客ID"],
          "onDelete": "CASCADE",
          "onUpdate": "CASCADE"
        },
        {
          "name": "fk_purchase_product",
          "columns": ["商品ID"],
          "referencesTable": "商品",
          "referencesColumns": ["商品ID"],
          "onDelete": "CASCADE",
          "onUpdate": "CASCADE"
        }
      ],
      "indexes": []
    }
  ]
}

{
  "version": "1.0",
  "description": "tablesディレクトリ内のCSVで表される各テーブルのRDBスキーマ情報。社員と社員証の1対多のカーディナリティーを表す。",
  "tables": [
    {
      "name": "社員",
      "description": "社員情報の一覧。各社員は複数件の社員証を持つことができる。",
      "primaryKey": ["社員ID"],
      "columns": [
        {
          "name": "社員ID",
          "type": "INTEGER",
          "nullable": false,
          "autoIncrement": true,
          "comment": "主キー。社員ID。"
        },
        {
          "name": "氏名",
          "type": "TEXT",
          "nullable": false,
          "comment": "社員の氏名。"
        }
      ],
      "foreignKeys": [],
      "indexes": []
    },
    {
      "name": "社員証",
      "description": "社員証の一覧。各社員証は1件の社員に紐づく。1対多の関係のため、社員証IDが主キー、社員IDが外部キーとして機能する。",
      "primaryKey": ["社員証ID"],
      "columns": [
        {
          "name": "社員証ID",
          "type": "INTEGER",
          "nullable": false,
          "autoIncrement": true,
          "comment": "主キー。社員証ID。"
        },
        {
          "name": "社員ID",
          "type": "INTEGER",
          "nullable": false,
          "comment": "外部キー。社員.社員ID を参照。社員証を持つ社員。"
        },
        {
          "name": "発行日",
          "type": "DATE",
          "nullable": false,
          "comment": "社員証の発行日。"
        }
      ],
      "foreignKeys": [
        {
          "name": "fk_社員証_社員",
          "columns": ["社員ID"],
          "referencesTable": "社員",
          "referencesColumns": ["社員ID"],
          "onDelete": "RESTRICT",
          "onUpdate": "CASCADE"
        }
      ],
      "indexes": [
        {
          "name": "idx_社員証_社員ID",
          "columns": ["社員ID"],
          "unique": false
        }
      ]
    }
  ]
}
